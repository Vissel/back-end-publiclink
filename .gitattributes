/mvnw text eol=lf
*.cmd text eol=crlf
# Shell scripts are executed by bash on the Linux host: CRLF makes every
# backslash line-continuation a syntax error.
*.sh text eol=lf
# Consumed verbatim by nginx and systemd, where a trailing CR corrupts values.
*.conf text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.service text eol=lf

# /etc/publiclink/publiclink.env
#
# Shared by the four systemd units in deploy/systemd/ (they all point
# EnvironmentFile at this one file). Install it with:
#
#     sudo install -d -m 750 -o publiclink -g publiclink /etc/publiclink
#     sudo install -m 640 -o publiclink -g publiclink publiclink.env /etc/publiclink/publiclink.env
#
# SECURITY: this file holds signing keys and DB passwords. Keep it mode 0640,
# owned by the service account, and never commit the filled-in copy.

# ── Shared secrets ────────────────────────────────────────────────────────────
# apiGateway + publiclink-app must use the SAME value, otherwise every token
# the gateway issues is rejected downstream.
JWT_KEY=
JWT_URLKEY=

# ── RSA key pair (private key must be an absolute path) ──────────────────────
# RsaService and UserConfig read these with java.nio.file.Paths, so a
# classpath: prefix does not resolve. Copy the PEMs shipped in
# apiGateway/src/main/resources/auth-service/ to this directory:
#     sudo install -d -m 700 -o publiclink /opt/publiclink/keys
#     sudo install -m 600 -o publiclink auth260222.pem pubauth.pem /opt/publiclink/keys/
RSA_PRIVATE_KEY_PATH=/opt/publiclink/keys/auth260222.pem
RSA_PUBKEY_PATH=/opt/publiclink/keys/pubauth.pem

# ── publiclink-app database (schema: publiclink-db) ──────────────────────────
DB_URL=jdbc:mysql://localhost:3306/publiclink-db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# ── user service database (schema: user_schema) ──────────────────────────────
# Deliberately a different prefix — the two services share this file.
USER_DB_URL=jdbc:mysql://localhost:3306/user_schema?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
USER_DB_USERNAME=
USER_DB_PASSWORD=

# ── chat service database (schema: chat_schema) ──────────────────────────────
# chat-app owns this schema and its own Liquibase changelog; publiclink-db stays
# owned by publiclink-app. Create the schema once before the first start:
#   CREATE DATABASE chat_schema CHARACTER SET utf8mb4;
#   CREATE USER 'chatuser'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL ON chat_schema.* TO 'chatuser'@'localhost';
CHAT_DB_URL=jdbc:mysql://localhost:3306/chat_schema?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
CHAT_DB_USERNAME=
CHAT_DB_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── Redis (gateway rate limiter) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Inter-service URLs (all on one machine) ──────────────────────────────────
# Gateway -> publiclink-app
PUBLICLINK_SERVICE_URL=http://127.0.0.1:9080
# Gateway -> user
USER_SERVICE_URL=http://127.0.0.1:8082
# Gateway -> chat-app (Zalo chat bridge)
CHAT_SERVICE_URL=http://127.0.0.1:9090
# chat-app port. CHAT_SERVER_PORT, not SERVER_PORT, because SERVER_PORT is
# shared by the other services through this one EnvironmentFile.
CHAT_SERVER_PORT=9090
# publiclink-app -> gateway (/security/v1/public/**)
SECURITY_SERVICE_URL=http://127.0.0.1:8080

# ── Mail (backup OTP) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.protonmail.ch
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Zalo chat bridge ─────────────────────────────────────────────────────────
# Read by chat-app (the publiclink-app service no longer touches these).
# Start with ZALO_ENABLED=false: the chat then works console-only, and nothing is
# sent outward. Flip it on once an OA exists, a Zalo App is registered against it
# and the one-time OAuth consent has been completed.
ZALO_ENABLED=false
# From the Zalo App overview page on developers.zalo.me.
ZALO_APP_ID=
ZALO_SECRET_KEY=
# The OA Secret Key shown on the Webhook page — the ONLY gate on the public
# webhook endpoint, so it must be present before ZALO_VERIFY_SIGNATURE can work.
ZALO_OA_SECRET_KEY=
ZALO_OA_ID=
# Zalo user id of the administrator who replies. Leave empty on first setup and
# instead let the admin DM the OA the word LINK-ADMIN once to bind automatically.
ZALO_ADMIN_USER_ID=
ZALO_ADMIN_LINK_CODE=LINK-ADMIN
# Must equal the OAuth Callback URL registered in the Zalo App, character for
# character (no trailing slash), otherwise Zalo answers -14003 Invalid redirect uri.
# The chat namespace is served by chat-app through the gateway.
ZALO_OAUTH_REDIRECT_URI=https://share-link.top/apiGateway/chat/api/v1/chat/zalo/consent/callback
# The Zalo webhook to register on the app's Webhook page is
#   https://share-link.top/apiGateway/chat/api/v1/chat/zalo/webhook
# File contents Zalo asks for during domain-ownership verification.
ZALO_DOMAIN_VERIFICATION_CODE=
# Escape hatch for the first bring-up when the consent flow is not wired yet: paste
# a token pair from the API Explorer. expires-at is epoch millis of the access token.
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_TOKEN_EXPIRES_AT=0
# Keep true in production. Setting false opens the webhook to anyone who can guess
# the URL, which is only acceptable on a local machine.
ZALO_VERIFY_SIGNATURE=true
# Rotates fingerprint/IP hashes of chat visitors. Changing it orphans every stored
# device, so returning visitors look new.
CHAT_IDENTITY_SALT=

# ── Browser push for the admin chat console ────────────────────────────────
# Optional. Without these the console works, the unread badges fill and the
# in-page chime still sounds; only the out-of-tab system notification stays
# switched off (the console hides its bell button). Generate once, anywhere:
#     npx --yes web-push generate-vapid-keys
# Public key into CHAT_VAPID_PUBLIC_KEY, private key into CHAT_VAPID_PRIVATE_KEY.
# Rotating them invalidates every stored subscription, so each administrator has
# to click the bell again afterwards.
CHAT_VAPID_PUBLIC_KEY=
CHAT_VAPID_PRIVATE_KEY=
# Contact URI sent in the VAPID JWT sub claim; any mailto: address works.
CHAT_VAPID_SUBJECT=mailto:admin@share-link.top

# ── NOTE ─────────────────────────────────────────────────────────────────────
# Do NOT set SERVER_ADDRESS here. The defaults in each application.properties
# bind to 127.0.0.1 so that only nginx is publicly reachable. Set
# SERVER_ADDRESS=0.0.0.0 only for debugging without the reverse proxy.

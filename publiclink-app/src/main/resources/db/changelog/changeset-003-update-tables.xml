<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

	<changeSet id="003" author="root">
		<modifyDataType columnName="user_name"
			tableName="request" newDataType="VARCHAR(50)"></modifyDataType>
		<update tableName="request">
			<column name="user_name" value="seller_id">
				<constraints foreignKeyName="user_id" />
			</column>
		</update>
		<addColumn tableName="request">
			<column name="created_by" type="VARCHAR(50)">
				<constraints foreignKeyName="user_id" />
			</column>
			<column name="authenticated" type="BOOLEAN"
				defaultValueBoolean="false" />
		</addColumn>
	</changeSet>
</databaseChangeLog>

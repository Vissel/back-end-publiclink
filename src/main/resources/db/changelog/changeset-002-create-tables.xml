<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

	<changeSet id="002" author="root">
		<createTable tableName="user">
			<column name="user_id" type="VARCHAR(50)">
				<constraints primaryKey="true" />
			</column>
			<column name="user_name" type="VARCHAR(50)" />
			<column name="temp_password" type="VARCHAR(50)" />
			<column name="name" type="VARCHAR(50)" />
			<column name="link" type="VARCHAR(250)" />
			<column name="type" type="VARCHAR(50)" />
			<column name="created_at" type="TIMESTAMP"
				defaultValueComputed="CURRENT_TIMESTAMP" />
		</createTable>
		<update tableName="request" catalogName="">
			<column name="req_id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" />
			</column>
			<column name="seller_id" type="VARCHAR(50)">
				<constraints foreignKeyName="user_id" />
			</column>
			<column name="description" type="VARCHAR(250)" />
			<column name="created_at" type="TIMESTAMP"
				defaultValueComputed="CURRENT_TIMESTAMP" />
			<column name="created_by" type="VARCHAR(50)">
				<constraints foreignKeyName="user_id" />
			</column>
			<column name="authenticated" type="bit(1)"
				defaultValueBoolean="false" />
		</update>
	</changeSet>
</databaseChangeLog>
